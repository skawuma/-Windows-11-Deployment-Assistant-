{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qnity Deployment Assistant configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configurationVersion",
    "input",
    "deviceSettings",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "configurationVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetTag",
        "userEmail"
      ],
      "properties": {
        "assetTag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "minimumLength",
            "maximumLength",
            "description"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "minimumLength": {
              "type": "integer",
              "minimum": 1
            },
            "maximumLength": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "userEmail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "maximumLength"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "maximumLength": {
              "type": "integer",
              "const": 254
            }
          }
        }
      }
    },
    "deviceSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeZone",
        "power"
      ],
      "properties": {
        "timeZone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "const": "Eastern Standard Time"
            }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "subgroupGuid",
            "lidClose",
            "powerButton",
            "sleepButton"
          ],
          "properties": {
            "scheme": {
              "const": "SCHEME_CURRENT"
            },
            "subgroupGuid": {
              "type": "string",
              "format": "uuid"
            },
            "lidClose": {
              "$ref": "#/$defs/lidOrSleepSetting"
            },
            "powerButton": {
              "$ref": "#/$defs/powerButtonSetting"
            },
            "sleepButton": {
              "$ref": "#/$defs/lidOrSleepSetting"
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionApprovalRequired",
        "deviceChangesRequireAdministrator",
        "apiEnabled",
        "downloadQueueEnabled"
      ],
      "properties": {
        "productionApprovalRequired": {
          "const": true
        },
        "deviceChangesRequireAdministrator": {
          "const": true
        },
        "apiEnabled": {
          "const": false
        },
        "downloadQueueEnabled": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "lidOrSleepSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settingGuid",
        "acValue",
        "dcValue"
      ],
      "properties": {
        "settingGuid": {
          "type": "string",
          "format": "uuid"
        },
        "acValue": {
          "const": 0
        },
        "dcValue": {
          "const": 0
        }
      }
    },
    "powerButtonSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settingGuid",
        "acValue",
        "dcValue"
      ],
      "properties": {
        "settingGuid": {
          "type": "string",
          "format": "uuid"
        },
        "acValue": {
          "const": 3
        },
        "dcValue": {
          "const": 3
        }
      }
    }
  }
}
